# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecoclean_db

# Server Configuration
PORT=5225

# PRODUCTION: Set your frontend origin (e.g. https://yourdomain.com). Empty = allow all (*) - only for development.
# CORS_ORIGIN=

# Dashboard / protected API password (GET/PATCH/DELETE /api/messages, GET /api/dashboard). Default if unset: admin123
# DASHBOARD_PASSWORD=admin123

# Rate limits (per IP per 15 minutes): general API default 100, POST messages default 20
# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_MESSAGES_MAX=20

# Email Configuration (SMTP) - use your own credentials; never commit real values to git
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=info@easywasteremoval.ie
